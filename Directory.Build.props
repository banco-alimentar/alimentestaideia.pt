<Project>
  <PropertyGroup>
    <AzureIdentityVersion>1.17.1</AzureIdentityVersion>
    <MicrosoftEntityFrameworkCoreVersion>10.0.13</MicrosoftEntityFrameworkCoreVersion>
    <MicrosoftExtensionsVersion>10.0.13</MicrosoftExtensionsVersion>
    <MicrosoftAspNetCoreVersion>10.0.13</MicrosoftAspNetCoreVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Test'))">
    <NoWarn>$(NoWarn);NU1901;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin cryptography dependencies to the patched .NET 10 release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
