@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Identity.Pages.Account.Manage.DonationHistoryModel
@using System.Text.Json
@{
    ViewData["Title"] = IdentitySharedLocalizer["DonationHistory"];
    ViewData["ActivePage"] = ManageNavPages.DonationHistory;
    var donationHistoryI18n = new Dictionary<string, object>
    {
        ["emptyTable"] = Localizer["DataTableEmptyTable"].Value,
        ["processing"] = Localizer["DataTableProcessing"].Value,
        ["lengthMenu"] = Localizer["DataTableLengthMenu"].Value,
        ["zeroRecords"] = Localizer["DataTableZeroRecords"].Value,
        ["search"] = Localizer["DataTableSearch"].Value,
        ["info"] = Localizer["DataTableInfo"].Value,
        ["infoEmpty"] = Localizer["DataTableInfoEmpty"].Value,
        ["paginateFirst"] = Localizer["DataTablePaginateFirst"].Value,
        ["paginatePrevious"] = Localizer["DataTablePaginatePrevious"].Value,
        ["paginateNext"] = Localizer["DataTablePaginateNext"].Value,
        ["paginateLast"] = Localizer["DataTablePaginateLast"].Value,
        ["searchHelpTooltip"] = Localizer["SearchHelpTooltip"].Value,
        ["subscription"] = Localizer["Subscription"].Value,
        ["donationInvoice"] = Localizer["DonationInvoice"].Value,
        ["invalidNif"] = Localizer["InvalidNIF"].Value,
        ["invalidNifTooltip"] = Localizer["InvalidNIFToolTip"].Value,
        ["paymentPendingStatus"] = Localizer["PaymentPendingStatus"].Value,
        ["completeDonation"] = Localizer["CompleteDonation"].Value,
        ["loadFailed"] = Localizer["LoadDonationsFailed"].Value,
        ["paymentTypes"] = new Dictionary<string, string>
        {
            ["CreditCard"] = IdentitySharedLocalizer["CreditCard"].Value,
        },
        ["paymentStatuses"] = new Dictionary<string, string>
        {
            ["Payed"] = Localizer["PaidStatus"].Value,
            ["WaitingPayment"] = Localizer["PaymentPendingStatus"].Value,
            ["NotPayed"] = Localizer["UnpaidStatus"].Value,
            ["ErrorPayment"] = Localizer["PaymentErrorStatus"].Value,
        },
    };
}
@section Css {
    <environment include="Development">
        <link href="~/lib/datatables.net-bs4/dataTables.bootstrap4.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/lib/datatables.net-bs4/dataTables.bootstrap4.min.css" rel="stylesheet" />
    </environment>
    <link href="~/css/account-history.css" rel="stylesheet" asp-append-version="true" />
}

<section class="donation-history account-history" aria-labelledby="donation-history-title">
    <h3 id="donation-history-title">@IdentitySharedLocalizer["DonationHistory"]</h3>
    <p class="text-muted">@Localizer["HistoryDescription"]</p>

    <dl class="account-history-summary">
        <div class="account-history-stat account-history-stat-total">
            <dt>@Localizer["TotalDonated"]</dt>
            <dd>@Model.GetsDonatedTotal.ToString("N2") €</dd>
        </div>
        <div class="account-history-stat">
            <dt>@Localizer["CompletedDonations"]</dt>
            <dd>@Model.GetsDonatedCount</dd>
        </div>
        <div class="account-history-stat">
            <dt>@Localizer["DonatingSince"]</dt>
            <dd>@(Model.GetsDonatedCount > 0 ? Model.GetsDonatedFirstDateString : "—")</dd>
        </div>
    </dl>

    <script type="application/json" id="donation-history-i18n">@Html.Raw(JsonSerializer.Serialize(donationHistoryI18n))</script>

    <div id="donation-history-load-error" class="alert alert-danger d-none" role="alert"></div>
    <div class="account-history-panel">
        <table id="donationHistory" class="table table-hover account-history-table" aria-labelledby="donation-history-title">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["DonationDateTime"]</th>
                    <th scope="col">@Localizer["DonationFoodBank"]</th>
                    <th scope="col">@Localizer["DonationAmount"]</th>
                    <th scope="col">@Localizer["DonationPaymentType"]</th>
                    <th scope="col">@Localizer["DonationPaymentStatus"]</th>
                    <th scope="col">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</section>
