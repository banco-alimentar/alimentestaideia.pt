@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Identity.Pages.Account.Manage.Subscriptions.DeleteModel

@{
    ViewData["Title"] = Localizer["Title"].Value;
    ViewData["ActivePage"] = ManageNavPages.SubscriptionManagement;
}

<h1>@Localizer["Title"]</h1>

<h3>@Localizer["CancelSubscriptionConfirmation"]</h3>
<div>
    <h4>@Localizer["Subscription"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Localizer["Created"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Subscription.Created)
        </dd>
        <dt class="col-sm-2">
            @Localizer["StartTime"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Subscription.StartTime)
        </dd>
        <dt class="col-sm-2">
            @Localizer["ExpirationTime"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Subscription.ExpirationTime)
        </dd>       
        <dt class="col-sm-2">
            @Localizer["SubscriptionType"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Subscription.SubscriptionType)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Subscription.Id" />
        <input type="submit" value="@Localizer["Delete"]" class="btn btn-danger" /> |
        <a asp-page="./Index">@Localizer["BackToList"]</a>
    </form>
</div>
