@using BancoAlimentar.AlimentaEstaIdeia.Sas.Core.Layout
@inject ITenantLayout tenantLayoutManager
@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout))
    {
        Layout = (string)parentLayout;
    }
    else
    {
        Layout = tenantLayoutManager.AdminLayout;
    }
}

@section Css {
    @RenderSection("Css", required: false)
    <link href="~/css/manage-account.css" rel="stylesheet" asp-append-version="true" />
}

<section class="account-manage" aria-labelledby="account-manage-title">
    <header class="account-manage-header">
        <div>
            <h1 id="account-manage-title">@IdentitySharedLocalizer["ManageAccount"]</h1>
            <p>@IdentitySharedLocalizer["ManageAccountMessage"]</p>
        </div>
        <span class="account-manage-header-icon" aria-hidden="true">
            <i class="fas fa-hand-holding-heart"></i>
        </span>
    </header>
    <div class="account-manage-grid">
        <nav class="account-manage-sidebar" aria-label="@IdentitySharedLocalizer["ManageAccount"]">
            <partial name="_ManageNav" />
        </nav>
        <div class="account-manage-content">
            @RenderBody()
        </div>
    </div>
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/datatables/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs4/dataTables.bootstrap4.js"></script>
        <script src="~/lib/datatables.net-buttons-bs4/buttons.bootstrap4.js"></script>
        <script src="~/lib/datatables.net-responsive-bs4/responsive.bootstrap4.js"></script>
        <script src="~/lib/datatables.net-plugins/moment-with-locales.min.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
        <script src="~/lib/datatables.net-bs4/dataTables.bootstrap4.min.js"></script>
        <script src="~/lib/datatables.net-buttons-bs4/buttons.bootstrap4.min.js"></script>
        <script src="~/lib/datatables.net-responsive-bs4/responsive.bootstrap4.min.js"></script>
        <script src="~/lib/datatables.net-plugins/moment-with-locales.min.js"></script>
    </environment>
    <script src="~/js/manage-account-datatables.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
