@page
@model ExternalLoginModel

<h1>@IdentitySharedLocalizer["Register"]</h1>
<h4 id="external-login-title">@Localizer["AssociateExternalAccount", Model.ProviderDisplayName]</h4>
<hr />

@if (Model.ShowExistingAccountHelp)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">@Localizer["ExistingAccountTitle"]</h5>
        @if (Model.ExistingAccountHasPassword)
        {
            <p>@Localizer["ExistingAccountWithPasswordMessage", Model.ExistingAccountEmail, Model.ProviderDisplayName]</p>
        }
        else if (Model.ExistingExternalLogins.Any())
        {
            <p>@Localizer["ExistingAccountExternalOnlyMessage", Model.ExistingAccountEmail, string.Join(", ", Model.ExistingExternalLogins)]</p>
        }
        else
        {
            <p>@Localizer["ExistingAccountWithPasswordMessage", Model.ExistingAccountEmail, Model.ProviderDisplayName]</p>
        }

        @if (Model.ExistingExternalLogins.Any())
        {
            <p>@Localizer["ExistingAccountLinkedProviders", string.Join(", ", Model.ExistingExternalLogins)]</p>
        }

        <hr />
        @if (Model.ShowEmailVerificationForm)
        {
            <div class="alert alert-info" role="status">
                @Localizer["EmailVerificationInstructions", Model.ExistingAccountEmail]
            </div>
            <form asp-page-handler="VerifyEmail" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mb-2">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="EmailVerificationCode">@Localizer["EmailVerificationCodeLabel"]</label>
                    <input asp-for="EmailVerificationCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
                    <span asp-validation-for="EmailVerificationCode" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">
                    @Localizer["VerifyEmailAndLinkProvider", Model.ProviderDisplayName]
                </button>
            </form>
            <form asp-page-handler="ResendEmailVerification" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <button type="submit" class="btn btn-outline-secondary">
                    @Localizer["ResendEmailVerificationCode"]
                </button>
            </form>
        }
        else
        {
            <div class="d-flex flex-column flex-sm-row flex-wrap">
                @if (Model.ExistingAccountHasPassword)
                {
                    <a class="btn btn-primary mb-2 mr-sm-2"
                       asp-page="./Login"
                       asp-route-linkExternalLogin="true"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        @Localizer["SignInToLinkProvider", Model.ProviderDisplayName]
                    </a>
                    <a class="btn btn-outline-secondary mb-2 mr-sm-2" asp-page="./ForgotPassword">
                        @Localizer["RecoverPassword"]
                    </a>
                    <a class="btn btn-outline-primary mb-2 mr-sm-2" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                        @Localizer["SignInWithLocalAccount"]
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-primary mb-2 mr-sm-2" asp-page="./ForgotPassword">
                        @Localizer["SetOrRecoverLocalPassword"]
                    </a>
                }
                <form asp-page-handler="StartEmailVerification" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <button type="submit" class="btn btn-outline-primary mb-2">
                        @Localizer["VerifyEmailAndLinkProvider", Model.ProviderDisplayName]
                    </button>
                </form>
            </div>
        }
        @if (Model.ShowEmailVerificationLinkConflictHelp)
        {
            <div class="alert alert-warning" role="alert">
                <h5 class="alert-heading">@Localizer["ExternalLoginEmailVerificationLinkConflictTitle"]</h5>
                <p>@Localizer["ExternalLoginEmailVerificationLinkConflictMessage", Model.ProviderDisplayName]</p>
                <hr />
                <p class="mb-2"><strong>@Localizer["ExternalLoginEmailVerificationLinkConflictSolutionsTitle"]</strong></p>
                <ul class="mb-0">
                    <li>@Localizer["ExternalLoginEmailVerificationLinkConflictSolutionSignInWithProvider", Model.ProviderDisplayName]</li>
                    <li>@Localizer["ExternalLoginEmailVerificationLinkConflictSolutionUseMatchingAccount"]</li>
                    <li>@Localizer["ExternalLoginEmailVerificationLinkConflictSolutionRemoveAndRetry", Model.ProviderDisplayName]</li>
                    <li>@Localizer["ExternalLoginEmailVerificationLinkConflictSolutionContactSupport"]</li>
                </ul>
            </div>
        }
    </div>
}
else
{
    <p id="external-login-description" class="text-info">
        @Localizer["MessageWelcome", Model.ProviderDisplayName]
    </p>

    <div class="row">
        <div class="col-md-4">
            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Input.Email">@IdentitySharedLocalizer["Email"]</label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.FullName">@IdentitySharedLocalizer["Name"]</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
                <div class="form-group"><h4>@IdentitySharedLocalizer["Other"]</h4></div>
                <div class="form-group">
                    <label asp-for="Input.PhoneNumber">@IdentitySharedLocalizer["PhoneNumber"]</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Nif">@IdentitySharedLocalizer["Nif"]</label>
                    <input asp-for="Input.Nif" class="form-control" />
                    <span asp-validation-for="Input.Nif" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.CompanyName">@IdentitySharedLocalizer["CompanyName"]</label>
                    <input asp-for="Input.CompanyName" class="form-control" />
                    <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
                </div>
                <div class="form-group"><h4>@IdentitySharedLocalizer["Address"]</h4></div>
                <div class="form-group">
                    <label asp-for="Input.Address.Address1">@IdentitySharedLocalizer["Address1"]</label>
                    <input asp-for="Input.Address.Address1" class="form-control" />
                    <span asp-validation-for="Input.Address.Address1" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Address.Address2">@IdentitySharedLocalizer["Address2"]</label>
                    <input asp-for="Input.Address.Address2" class="form-control" />
                    <span asp-validation-for="Input.Address.Address2" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Address.City">@IdentitySharedLocalizer["City"]</label>
                    <input asp-for="Input.Address.City" class="form-control" />
                    <span asp-validation-for="Input.Address.City" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Address.PostalCode">@IdentitySharedLocalizer["PostalCode"]</label>
                    <input asp-for="Input.Address.PostalCode" class="form-control" />
                    <span asp-validation-for="Input.Address.PostalCode" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Address.Country">@IdentitySharedLocalizer["Country"]</label>
                    <input asp-for="Input.Address.Country" class="form-control" />
                    <span asp-validation-for="Input.Address.Country" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">@IdentitySharedLocalizer["Register"]</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
