@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    string currentPage = ViewContext.RouteData.Values["page"] as string;
    bool isAdminHome = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    bool isSubscriptionDetails = string.Equals(currentPage, "/Subscriptions/Details", StringComparison.OrdinalIgnoreCase);
    string backUrl = isSubscriptionDetails ? "/Admin/Subscriptions" : "/Admin";
    string backTextKey = isSubscriptionDetails ? "BackToList" : "BackToAdminHome";
}

@if (!isAdminHome)
{
    <p class="mb-3">
        <a href="@backUrl"><i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>@AdminSharedLocalizer[backTextKey]</a>
    </p>
}

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
