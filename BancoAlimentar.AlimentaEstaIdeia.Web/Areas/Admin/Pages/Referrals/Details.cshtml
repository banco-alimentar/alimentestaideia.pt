@page "{id:int}"
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Referrals.DetailsModel

@{
    ViewData["Title"] = AdminSharedLocalizer["ReferralDonationsTitle"].Value;
}

<h1>@AdminSharedLocalizer["ReferralDonationsTitle"]</h1>
<h2 class="h4">@Model.Referral.Code — @Model.Referral.Name</h2>

<p>
    <a asp-area="Identity"
       asp-page="/Account/Manage/CampaignDetail"
       asp-route-id="@Model.Referral.Id">@AdminSharedLocalizer["CampaignDetails"]</a>
</p>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["NoReferralDonations"]</p>
}
else
{
    <p class="text-muted">
        @AdminSharedLocalizer["Showing"] @(((Model.PageIndex - 1) * 25) + 1)–@(Math.Min(Model.PageIndex * 25, Model.TotalCount))
        @AdminSharedLocalizer["PaginationOf"] @Model.TotalCount @AdminSharedLocalizer["DonationsLabel"]
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>@AdminSharedLocalizer["DonationDate"]</th>
                <th>@AdminSharedLocalizer["DonationAmount"]</th>
                <th>@AdminSharedLocalizer["Nif"]</th>
                <th>@AdminSharedLocalizer["PaymentStatus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donation in Model.Donations)
            {
                <tr>
                    <td>@Html.DisplayFor(_ => donation.DonationDate)</td>
                    <td>@Html.DisplayFor(_ => donation.DonationAmount)</td>
                    <td>@(string.IsNullOrWhiteSpace(donation.Nif) ? donation.User?.Nif ?? "—" : donation.Nif)</td>
                    <td>@Html.DisplayFor(_ => donation.PaymentStatus)</td>
                    <td>
                        <a asp-area="Admin" asp-page="/Donations/Details" asp-route-id="@donation.Id">@AdminSharedLocalizer["Details"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label='@AdminSharedLocalizer["DonationsPagination"]'>
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Details" asp-route-id="@Model.Id" asp-route-pageIndex="@(Model.PageIndex - 1)">@AdminSharedLocalizer["Previous"]</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@AdminSharedLocalizer["Page"] @Model.PageIndex @AdminSharedLocalizer["PaginationOf"] @Model.TotalPages</span></li>
                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Details" asp-route-id="@Model.Id" asp-route-pageIndex="@(Model.PageIndex + 1)">@AdminSharedLocalizer["Next"]</a>
                </li>
            </ul>
        </nav>
    }
}

<p class="mt-3">
    <a asp-page="./Index">@AdminSharedLocalizer["BackToActiveReferrals"]</a>
</p>
