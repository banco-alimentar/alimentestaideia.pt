@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Referrals.IndexModel
@using BancoAlimentar.AlimentaEstaIdeia.Web.Services
@inject ReferralImageService ReferralImageService

@{
    ViewData["Title"] = AdminSharedLocalizer["ActiveReferralsTitle"].Value;
}

<h1>@AdminSharedLocalizer["ActiveReferralsTitle"]</h1>

@if (Model.Referrals.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["NoActiveReferrals"]</p>
}
else
{
    <p class="text-muted">
        @AdminSharedLocalizer["Showing"]
        @(((Model.PageIndex - 1) * Model.ReferralsPerPage) + 1)–@(Math.Min(Model.PageIndex * Model.ReferralsPerPage, Model.TotalCount))
        @AdminSharedLocalizer["PaginationOf"] @Model.TotalCount @AdminSharedLocalizer["ActiveReferralsTitle"]
    </p>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@AdminSharedLocalizer["ReferralImage"]</th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="Code" asp-route-sortDescending="@Model.GetNextSortDescending("Code")">
                            @AdminSharedLocalizer["ReferralCode"]@Model.GetSortIndicator("Code")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="Name" asp-route-sortDescending="@Model.GetNextSortDescending("Name")">
                            @AdminSharedLocalizer["ReferralName"]@Model.GetSortIndicator("Name")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="CreateDate" asp-route-sortDescending="@Model.GetNextSortDescending("CreateDate")">
                            @AdminSharedLocalizer["CreateDate"]@Model.GetSortIndicator("CreateDate")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="LinkOpenCount" asp-route-sortDescending="@Model.GetNextSortDescending("LinkOpenCount")">
                            @AdminSharedLocalizer["ReferralLinkOpenCount"]@Model.GetSortIndicator("LinkOpenCount")
                        </a>
                    </th>
                    <th scope="col">@AdminSharedLocalizer["ReferralConversionRatio"]</th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="DonationCount" asp-route-sortDescending="@Model.GetNextSortDescending("DonationCount")">
                            @AdminSharedLocalizer["DonationCount"]@Model.GetSortIndicator("DonationCount")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="PaidDonationAmount" asp-route-sortDescending="@Model.GetNextSortDescending("PaidDonationAmount")">
                            @AdminSharedLocalizer["PaidDonationAmount"]@Model.GetSortIndicator("PaidDonationAmount")
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-page="./Index" asp-route-pageIndex="1" asp-route-sortBy="LastDonationDate" asp-route-sortDescending="@Model.GetNextSortDescending("LastDonationDate")">
                            @AdminSharedLocalizer["LastDonationDate"]@Model.GetSortIndicator("LastDonationDate")
                        </a>
                    </th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var referral in Model.Referrals)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(referral.ImageUrl))
                            {
                                <img src="@ReferralImageService.ResolveUrl(referral.ImageUrl)"
                                     alt="@(string.IsNullOrWhiteSpace(referral.Name) ? AdminSharedLocalizer["ReferralImage"] : referral.Name)"
                                     style="max-width: 80px; max-height: 80px; object-fit: contain;" />
                            }
                        </td>
                        <td>
                            <a asp-area="Identity"
                               asp-page="/Account/Manage/CampaignDetail"
                               asp-route-id="@referral.Id">@referral.Code</a>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(referral.Name) ? "—" : referral.Name)</td>
                        <td>@referral.CreateDate.ToString("g")</td>
                        <td>@referral.LinkOpenCount</td>
                        <td>@(referral.ConversionRatio?.ToString("F2") ?? "—")</td>
                        <td>@referral.DonationCount</td>
                        <td>@referral.PaidDonationAmount.ToString("F2") €</td>
                        <td>@(referral.LastDonationDate?.ToString("g") ?? "—")</td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@referral.Id">@AdminSharedLocalizer["ViewDonations"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="@AdminSharedLocalizer["ActiveReferralsTitle"]">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" aria-disabled="@(Model.HasPreviousPage ? "false" : "true")">
                        @AdminSharedLocalizer["Previous"]
                    </a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@AdminSharedLocalizer["Page"] @Model.PageIndex @AdminSharedLocalizer["PaginationOf"] @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" aria-disabled="@(Model.HasNextPage ? "false" : "true")">
                        @AdminSharedLocalizer["Next"]
                    </a>
                </li>
            </ul>
        </nav>
    }
}

<p class="mt-3">
    <a asp-area="Admin" asp-page="/Index">@AdminSharedLocalizer["BackToAdminHome"]</a>
</p>
