@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.PaymentNotifications.IndexModel

@{
    ViewData["Title"] = AdminSharedLocalizer["PaymentNotificationsTitle"].Value;
}

<h1>@AdminSharedLocalizer["PaymentNotificationsTitle"]</h1>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["PaymentNotificationsEmpty"]</p>
}
else
{
    <p class="text-muted">
        @AdminSharedLocalizer["Showing"]
        @(((Model.PageIndex - 1) * 25) + 1)–@(Math.Min(Model.PageIndex * 25, Model.TotalCount))
        @AdminSharedLocalizer["PaginationOf"] @Model.TotalCount @AdminSharedLocalizer["PaymentNotificationsLabel"]
    </p>

    <table class="table">
        <caption>@AdminSharedLocalizer["PaymentNotificationsTableCaption"]</caption>
        <thead>
            <tr>
                <th>@AdminSharedLocalizer["PaymentNotificationsSentAt"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsSubject"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsRecipient"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsPayment"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsDonation"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsUser"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var notification in Model.Notifications)
        {
            <tr>
                <td>@notification.Created.ToLocalTime()</td>
                <td>@(string.IsNullOrWhiteSpace(notification.Subject) ? AdminSharedLocalizer["PaymentNotificationsNoSubject"] : notification.Subject)</td>
                <td>@(notification.User?.Email ?? "—")</td>
                <td>@(notification.Payment == null ? "—" : notification.Payment.Id.ToString())</td>
                <td>
                    @if (notification.Payment?.Donation != null)
                    {
                        <a asp-area="Admin" asp-page="/Donations/Details" asp-route-id="@notification.Payment.Donation.Id">
                            @notification.Payment.Donation.Id
                        </a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>
                    @if (notification.User != null)
                    {
                        <a asp-area="Admin" asp-page="/Users/Details" asp-route-id="@notification.User.Id">@notification.User.Email</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Payment notifications pagination">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex - 1)" aria-disabled="@(!Model.HasPreviousPage)">
                        @AdminSharedLocalizer["Previous"]
                    </a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@AdminSharedLocalizer["Page"] @Model.PageIndex @AdminSharedLocalizer["PaginationOf"] @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex + 1)" aria-disabled="@(!Model.HasNextPage)">
                        @AdminSharedLocalizer["Next"]
                    </a>
                </li>
            </ul>
        </nav>
    }
}

<p class="mt-3">
    <a asp-page="../Index">@AdminSharedLocalizer["BackToAdminHome"]</a>
</p>
