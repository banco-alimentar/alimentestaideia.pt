@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Users.DetailsModel

@{
    ViewData["Title"] = AdminSharedLocalizer["UserDetails"].Value;
}

<h1 id="user-details">@AdminSharedLocalizer["UserDetails"]</h1>

<nav class="mb-4" aria-labelledby="user-details-contents-heading">
    <h2 id="user-details-contents-heading" class="h5">@AdminSharedLocalizer["UserDetailsTableOfContents"]</h2>
    <ul>
        <li><a href="#user-details">@AdminSharedLocalizer["UserDetails"]</a></li>
        <li><a href="#user-donations">@AdminSharedLocalizer["UserDonations"]</a></li>
        <li><a href="#sent-communications">@AdminSharedLocalizer["EmailCommunicationsTitle"]</a></li>
    </ul>
</nav>

<div>
    <h4>@AdminSharedLocalizer["UserDetails"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@AdminSharedLocalizer["FullName"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.FullName</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["Email"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.Email</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["Nif"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.Nif</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["CompanyName"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.CompanyName</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["PhoneNumber"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.PhoneNumber</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["UserName"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.UserName</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["EmailConfirmed"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.EmailConfirmed</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["PhoneNumberConfirmed"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.PhoneNumberConfirmed</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["IsAnonymous"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.IsAnonymous</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["TwoFactorEnabled"]</dt>
        <dd class="col-sm-9">@Model.DonorUser.TwoFactorEnabled</dd>

        <dt class="col-sm-3">@AdminSharedLocalizer["Roles"]</dt>
        <dd class="col-sm-9">
            @(Model.Roles.Count == 0 ? "—" : string.Join(", ", Model.Roles))
        </dd>

        @if (Model.DonorUser.Address != null)
        {
            <dt class="col-sm-3">@AdminSharedLocalizer["Address1"]</dt>
            <dd class="col-sm-9">@Model.DonorUser.Address.Address1</dd>

            <dt class="col-sm-3">@AdminSharedLocalizer["Address2"]</dt>
            <dd class="col-sm-9">@Model.DonorUser.Address.Address2</dd>

            <dt class="col-sm-3">@AdminSharedLocalizer["City"]</dt>
            <dd class="col-sm-9">@Model.DonorUser.Address.City</dd>

            <dt class="col-sm-3">@AdminSharedLocalizer["PostalCode"]</dt>
            <dd class="col-sm-9">@Model.DonorUser.Address.PostalCode</dd>

            <dt class="col-sm-3">@AdminSharedLocalizer["Country"]</dt>
            <dd class="col-sm-9">@Model.DonorUser.Address.Country</dd>
        }
    </dl>
</div>

<h4 id="user-donations" class="mt-4">@AdminSharedLocalizer["UserDonations"]</h4>
<hr />

@if (Model.Donations.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["NoDonationsFound"]</p>
}
else
{
    <p class="text-muted mb-3">
        @AdminSharedLocalizer["Showing"]
        @(((Model.PageIndex - 1) * Model.DonationsPerPage) + 1)–@(Math.Min(Model.PageIndex * Model.DonationsPerPage, Model.TotalDonationCount))
        @AdminSharedLocalizer["PaginationOf"] @Model.TotalDonationCount @AdminSharedLocalizer["DonationsLabel"]
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="1"
                       asp-route-sortBy="DonationDate"
                       asp-route-sortDescending="@Model.GetNextSortDescending("DonationDate")"
                       asp-route-paymentNotificationPageIndex="@Model.PaymentNotificationPageIndex">
                        @AdminSharedLocalizer["DonationDate"]@Model.GetSortIndicator("DonationDate")
                    </a>
                </th>
                <th>
                    <a asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="1"
                       asp-route-sortBy="DonationAmount"
                       asp-route-sortDescending="@Model.GetNextSortDescending("DonationAmount")"
                       asp-route-paymentNotificationPageIndex="@Model.PaymentNotificationPageIndex">
                        @AdminSharedLocalizer["DonationAmount"]@Model.GetSortIndicator("DonationAmount")
                    </a>
                </th>
                <th>@AdminSharedLocalizer["PaymentStatus"]</th>
                <th>@AdminSharedLocalizer["PaymentType"]</th>
                <th>@AdminSharedLocalizer["DonationSubscriptionRole"]</th>
                <th>@AdminSharedLocalizer["ServiceReference"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donation in Model.Donations)
            {
                <tr>
                    <td>@donation.DonationDate</td>
                    <td>@donation.DonationAmount</td>
                    <td>@donation.PaymentStatus</td>
                    <td>
                        @{
                            var paymentType = Model.GetPaymentTypeName(donation);
                        }
                        @(string.IsNullOrEmpty(paymentType) ? "—" : paymentType)
                    </td>
                    <td>
                        @if (!Model.SubscriptionInfoByDonationId.TryGetValue(donation.Id, out var subscriptionInfo))
                        {
                            @AdminSharedLocalizer["DonationSubscriptionNone"]
                        }
                        else
                        {
                            @(subscriptionInfo.IsInitial
                                ? AdminSharedLocalizer["DonationSubscriptionInitial"]
                                : AdminSharedLocalizer["DonationSubscriptionRecurring"])
                            <span class="text-muted"> — </span>
                            <a asp-area="Admin"
                               asp-page="/Subscriptions/Details"
                               asp-route-id="@subscriptionInfo.Subscription.Id">@AdminSharedLocalizer["SubscriptionDetails"]</a>
                        }
                    </td>
                    <td>@donation.ServiceReference</td>
                    <td>
                        <a asp-area="Admin" asp-page="/Donations/Details" asp-route-id="@donation.Id">@AdminSharedLocalizer["Details"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalDonationPages > 1)
    {
        <nav aria-label="Donations pagination">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousDonationPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="@(Model.PageIndex - 1)"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDescending="@Model.SortDescending"
                       asp-route-paymentNotificationPageIndex="@Model.PaymentNotificationPageIndex"
                       aria-disabled="@(!Model.HasPreviousDonationPage)">@AdminSharedLocalizer["Previous"]</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@AdminSharedLocalizer["Page"] @Model.PageIndex @AdminSharedLocalizer["PaginationOf"] @Model.TotalDonationPages</span>
                </li>
                <li class="page-item @(Model.HasNextDonationPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="@(Model.PageIndex + 1)"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDescending="@Model.SortDescending"
                       asp-route-paymentNotificationPageIndex="@Model.PaymentNotificationPageIndex"
                       aria-disabled="@(!Model.HasNextDonationPage)">@AdminSharedLocalizer["Next"]</a>
                </li>
            </ul>
        </nav>
    }
}

<h4 id="payment-notifications" class="mt-4">@AdminSharedLocalizer["PaymentNotificationsTitle"]</h4>
<hr />

@if (Model.PaymentNotifications.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["PaymentNotificationsEmpty"]</p>
}
else
{
    <p class="text-muted mb-3">
        @AdminSharedLocalizer["Showing"]
        @(((Model.PaymentNotificationPageIndex - 1) * Model.PaymentNotificationsPerPage) + 1)–@(Math.Min(Model.PaymentNotificationPageIndex * Model.PaymentNotificationsPerPage, Model.TotalPaymentNotificationCount))
        @AdminSharedLocalizer["PaginationOf"] @Model.TotalPaymentNotificationCount @AdminSharedLocalizer["PaymentNotificationsLabel"]
    </p>

    <table class="table">
        <caption>@AdminSharedLocalizer["PaymentNotificationsTableCaption"]</caption>
        <thead>
            <tr>
                <th>@AdminSharedLocalizer["PaymentNotificationsSentAt"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsSubject"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsPayment"]</th>
                <th>@AdminSharedLocalizer["PaymentNotificationsDonation"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var notification in Model.PaymentNotifications)
        {
            <tr>
                <td>@notification.Created.ToLocalTime()</td>
                <td>@(string.IsNullOrWhiteSpace(notification.Subject) ? AdminSharedLocalizer["PaymentNotificationsNoSubject"] : notification.Subject)</td>
                <td>@(notification.Payment == null ? "—" : notification.Payment.Id.ToString())</td>
                <td>
                    @if (notification.Payment?.Donation != null)
                    {
                        <a asp-area="Admin" asp-page="/Donations/Details" asp-route-id="@notification.Payment.Donation.Id">@notification.Payment.Donation.Id</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.TotalPaymentNotificationPages > 1)
    {
        <nav aria-label="Payment notifications pagination">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPaymentNotificationPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="@Model.PageIndex"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDescending="@Model.SortDescending"
                       asp-route-paymentNotificationPageIndex="@(Model.PaymentNotificationPageIndex - 1)"
                       aria-disabled="@(!Model.HasPreviousPaymentNotificationPage)">@AdminSharedLocalizer["Previous"]</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@AdminSharedLocalizer["Page"] @Model.PaymentNotificationPageIndex @AdminSharedLocalizer["PaginationOf"] @Model.TotalPaymentNotificationPages</span>
                </li>
                <li class="page-item @(Model.HasNextPaymentNotificationPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       asp-page="./Details"
                       asp-route-id="@Model.DonorUser.Id"
                       asp-route-pageIndex="@Model.PageIndex"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDescending="@Model.SortDescending"
                       asp-route-paymentNotificationPageIndex="@(Model.PaymentNotificationPageIndex + 1)"
                       aria-disabled="@(!Model.HasNextPaymentNotificationPage)">@AdminSharedLocalizer["Next"]</a>
                </li>
            </ul>
        </nav>
    }
}

<h4 id="sent-communications" class="mt-4">@AdminSharedLocalizer["EmailCommunicationsTitle"]</h4>
<hr />

@if (Model.EmailCommunications.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["EmailCommunicationsEmpty"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <caption>@AdminSharedLocalizer["EmailCommunicationsTitle"]</caption>
            <thead>
                <tr>
                    <th>@AdminSharedLocalizer["EmailCommunicationsFrom"]</th>
                    <th>@AdminSharedLocalizer["EmailCommunicationsTo"]</th>
                    <th>@AdminSharedLocalizer["EmailCommunicationsSentAt"]</th>
                    <th>@AdminSharedLocalizer["EmailCommunicationsSubject"]</th>
                    <th>@AdminSharedLocalizer["EmailCommunicationsPayment"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var communication in Model.EmailCommunications)
            {
                <tr>
                    <td>@communication.FromAddress</td>
                    <td>@communication.ToAddress</td>
                    <td>@communication.SentAtUtc.ToLocalTime()</td>
                    <td>@(string.IsNullOrWhiteSpace(communication.Subject) ? AdminSharedLocalizer["PaymentNotificationsNoSubject"] : communication.Subject)</td>
                    <td>
                        @if (communication.Payment?.Donation != null)
                        {
                            <a asp-area="Admin" asp-page="/Donations/Details" asp-route-id="@communication.Payment.Donation?.Id">
                                @communication.Payment.Id
                            </a>
                        }
                        else if (communication.Payment != null)
                        {
                            @communication.Payment.Id
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<p class="mt-3">
    <a asp-area="Admin" asp-page="/Donations/Index">@AdminSharedLocalizer["BackToList"]</a>
</p>
