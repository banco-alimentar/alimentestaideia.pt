@page
@using BancoAlimentar.AlimentaEstaIdeia.Model
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Donations.DetailsModel

@{
    ViewData["Title"] = AdminSharedLocalizer["Details"].Value;
}

<h1>@AdminSharedLocalizer["Details"]</h1>

<div>
    <h4>@AdminSharedLocalizer["Donation"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@AdminSharedLocalizer["PublicId"]</dt>
        <dd class="col-sm-10">
            <a asp-area="Identity"
               asp-page="/Account/Manage/GenerateInvoice"
               asp-route-publicDonationId="@Model.Donation.PublicId"
               target="_blank"
               rel="noopener noreferrer">@Model.Donation.PublicId</a>
        </dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["DonationDate"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.DonationDate)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["Campaign"]</dt>
        <dd class="col-sm-10">
            @if (Model.Donation.Campaign != null)
            {
                <a asp-area="Admin" asp-page="/Campaigns/Details" asp-route-id="@Model.Donation.Campaign.Id">@Model.Donation.Campaign.Number</a>
                <span class="text-muted"> (Id: @Model.Donation.Campaign.Id)</span>
                @if (Model.Donation.Campaign.IsDefaultCampaign)
                {
                    <span class="text-muted"> — @AdminSharedLocalizer["IsDefaultCampaign"]</span>
                }
            }
            else if (Model.Donation.CampaignId.HasValue)
            {
                <span>@AdminSharedLocalizer["CampaignId"]: @Model.Donation.CampaignId</span>
                @if (!string.IsNullOrWhiteSpace(Model.Donation.CampaignName))
                {
                    <span class="text-muted"> — @Model.Donation.CampaignName</span>
                }
            }
            else if (!string.IsNullOrWhiteSpace(Model.Donation.CampaignName))
            {
                @Model.Donation.CampaignName
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["FoodBank"]</dt>
        <dd class="col-sm-10">
            @if (Model.Donation.FoodBank != null)
            {
                @Model.Donation.FoodBank.Name
                <span class="text-muted"> (Id: @Model.Donation.FoodBank.Id)</span>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["DonationAmount"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.DonationAmount)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["WantsReceipt"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.WantsReceipt)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["ReferralCode"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.ReferralEntity.Name)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["PaymentStatus"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.PaymentStatus)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["DonationSubscriptionRole"]</dt>
        <dd class="col-sm-10">
            @if (!Model.IsSubscriptionDonation)
            {
                @AdminSharedLocalizer["DonationSubscriptionNone"]
            }
            else if (Model.IsInitialSubscriptionDonation)
            {
                @AdminSharedLocalizer["DonationSubscriptionInitial"]
                <span class="text-muted"> — </span>
                <a asp-area="Admin" asp-page="/Subscriptions/Details" asp-route-id="@Model.RelatedSubscription.Id">@AdminSharedLocalizer["SubscriptionDetails"]</a>
            }
            else
            {
                @AdminSharedLocalizer["DonationSubscriptionRecurring"]
                <span class="text-muted"> — </span>
                <a asp-area="Admin" asp-page="/Subscriptions/Details" asp-route-id="@Model.RelatedSubscription.Id">@AdminSharedLocalizer["SubscriptionDetails"]</a>
            }
        </dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["ServiceEntity"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.ServiceEntity)</dd>
        <dt class="col-sm-2">@AdminSharedLocalizer["ServiceReference"]</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Donation.ServiceReference)</dd>
    </dl>
</div>

<h4 class="mt-4">@AdminSharedLocalizer["PaymentsTitle"]</h4>
<hr />
@if (Model.Payments.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["NoPaymentsFound"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@AdminSharedLocalizer["Number"]</th>
                <th>@AdminSharedLocalizer["PaymentType"]</th>
                <th>@AdminSharedLocalizer["TransactionKey"]</th>
                <th>@AdminSharedLocalizer["EasyPayPaymentId"]</th>
                <th>@AdminSharedLocalizer["Status"]</th>
                <th>@AdminSharedLocalizer["Created"]</th>
                <th>@AdminSharedLocalizer["Completed"]</th>
                <th>@AdminSharedLocalizer["Requested"]</th>
                <th>@AdminSharedLocalizer["Paid"]</th>
                <th>@AdminSharedLocalizer["ConfirmedPayment"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model.Payments)
            {
                var easyPayValues = payment as EasyPayWithValuesBaseClass;
                var payPalPayment = payment as PayPalPayment;
                var easyPayPaymentId = Model.GetEasyPayPaymentId(payment);
                var easyPayPaymentUrl = EasyPayBackOfficeLinks.BuildPaymentUrl(easyPayPaymentId, WebHostEnvironment);
                <tr>
                    <td>@payment.Id</td>
                    <td>@Model.GetPaymentTypeName(payment)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(payment.TransactionKey))
                        {
                            <a asp-area="Admin" asp-page="/SearchEasypay" asp-route-transactionKey="@payment.TransactionKey">@payment.TransactionKey</a>
                        }
                    </td>
                    <td>
                        @if (easyPayPaymentUrl != null)
                        {
                            <span>@easyPayPaymentId</span>
                            <a href="@easyPayPaymentUrl" target="_blank" rel="noopener noreferrer">(@AdminSharedLocalizer["EasyPayViewInBackOffice"])</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>@payment.Status</td>
                    <td>@payment.Created.ToString("g")</td>
                    <td>@(payment.Completed?.ToString("g") ?? "—")</td>
                    <td>@(easyPayValues?.Requested.ToString() ?? "—")</td>
                    <td>@(easyPayValues?.Paid.ToString() ?? "—")</td>
                    <td>@(Model.IsConfirmedPayment(payment) ? "✓" : "—")</td>
                </tr>
                @if (payPalPayment != null)
                {
                    <tr class="table-light">
                        <td colspan="10" class="small text-muted">
                            PayPal: @payPalPayment.PayPalPaymentId | Payer: @payPalPayment.PayerId | Token: @payPalPayment.Token
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<h4 class="mt-4">@AdminSharedLocalizer["PaymentNotificationsTitle"]</h4>
<hr />
@if (Model.PaymentNotifications.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["PaymentNotificationsEmpty"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <caption>@AdminSharedLocalizer["PaymentNotificationsTableCaption"]</caption>
            <thead>
                <tr>
                    <th>@AdminSharedLocalizer["PaymentNotificationsSentAt"]</th>
                    <th>@AdminSharedLocalizer["PaymentNotificationsSubject"]</th>
                    <th>@AdminSharedLocalizer["PaymentNotificationsPayment"]</th>
                    <th>@AdminSharedLocalizer["PaymentNotificationsDonation"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var notification in Model.PaymentNotifications)
            {
                <tr>
                    <td>@notification.Created.ToLocalTime()</td>
                    <td>@(string.IsNullOrWhiteSpace(notification.Subject) ? AdminSharedLocalizer["PaymentNotificationsNoSubject"] : notification.Subject)</td>
                    <td>@(notification.Payment == null ? "—" : notification.Payment.Id.ToString())</td>
                    <td>@Model.Donation.Id</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<details class="mt-4">
    <summary class="h4">@AdminSharedLocalizer["EasyPaySectionTitle"]</summary>
    <div class="mt-3">
        @if (!string.IsNullOrEmpty(Model.EasyPayError))
        {
            <div class="alert alert-warning" role="alert">
                @Model.EasyPayError
            </div>
        }

        @if (Model.EasyPayPaymentLookups.Count == 0)
        {
            <p class="text-muted">@AdminSharedLocalizer["EasyPayNoDonationPayments"]</p>
        }
        else
        {
            foreach (var paymentDetails in Model.EasyPayPaymentLookups)
            {
                var localPayment = paymentDetails.LocalPayment;
                var providerPayment = paymentDetails.ProviderPayment;
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>@AdminSharedLocalizer["EasyPayPaymentDetails"]</strong>
                        <span> — @AdminSharedLocalizer["LocalDatabase"] @localPayment.Id</span>
                    </div>
                    <div class="card-body">
                        <h6>@AdminSharedLocalizer["EasyPayLocalPaymentDetails"]</h6>
                        <dl class="row">
                            <dt class="col-sm-3">@AdminSharedLocalizer["Number"]</dt>
                            <dd class="col-sm-9">@localPayment.Id</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["PaymentType"]</dt>
                            <dd class="col-sm-9">@Model.GetPaymentTypeName(localPayment)</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayPaymentId"]</dt>
                            <dd class="col-sm-9">
                                @if (EasyPayBackOfficeLinks.BuildPaymentUrl(localPayment.EasyPayPaymentId, WebHostEnvironment) is string localPaymentUrl)
                                {
                                    <span>@localPayment.EasyPayPaymentId</span>
                                    <a href="@localPaymentUrl" target="_blank" rel="noopener noreferrer">(@AdminSharedLocalizer["EasyPayViewInBackOffice"])</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["TransactionKey"]</dt>
                            <dd class="col-sm-9">@(localPayment.TransactionKey ?? "—")</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["Status"]</dt>
                            <dd class="col-sm-9">@(localPayment.Status ?? "—")</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["Created"]</dt>
                            <dd class="col-sm-9">@localPayment.Created.ToString("g")</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["Completed"]</dt>
                            <dd class="col-sm-9">@(localPayment.Completed?.ToString("g") ?? "—")</dd>
                            <dt class="col-sm-3">@AdminSharedLocalizer["ConfirmedPayment"]</dt>
                            <dd class="col-sm-9">@(Model.IsConfirmedPayment(localPayment) ? "✓" : "—")</dd>
                        </dl>

                        @if (!string.IsNullOrEmpty(paymentDetails.LookupError))
                        {
                            <div class="alert alert-warning" role="alert">
                                @paymentDetails.LookupError
                            </div>
                        }
                        else if (paymentDetails.ProviderTransaction != null)
                        {
                            var providerTransaction = paymentDetails.ProviderTransaction;
                            <h6>@AdminSharedLocalizer["EasyPayProviderTransactionDetails"]</h6>
                            <dl class="row">
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayProviderId"]</dt>
                                <dd class="col-sm-9">
                                    @if (EasyPayBackOfficeLinks.BuildPaymentUrl(providerTransaction.Id, WebHostEnvironment) is string providerTransactionUrl)
                                    {
                                        <span>@providerTransaction.Id</span>
                                        <a href="@providerTransactionUrl" target="_blank" rel="noopener noreferrer">(@AdminSharedLocalizer["EasyPayViewInBackOffice"])</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayProviderKey"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Key ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransactionCreatedAt"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.CreatedAt ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransactionDate"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Date ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayPaymentMethod"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Method ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayRequested"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.Requested.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayPaid"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.Paid.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayFixedFee"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.FixedFee.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayVariableFee"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.VariableFee.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTax"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.Tax.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransfer"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Values?.Transfer.ToString("F2") ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransferDate"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.TransferDate ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransferBatch"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.TransferBatch ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayDocumentNumber"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.DocumentNumber ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayDescription"]</dt>
                                <dd class="col-sm-9">@(providerTransaction.Descriptive ?? "—")</dd>
                            </dl>

                            <details>
                                <summary>@AdminSharedLocalizer["EasyPayRawResponse"]</summary>
                                <pre class="small mt-2">@providerTransaction.ToJson()</pre>
                            </details>
                        }
                        else if (providerPayment == null)
                        {
                            <p class="text-muted">@AdminSharedLocalizer["EasyPayProviderUnavailable"]</p>
                        }
                        else
                        {
                            <h6>@AdminSharedLocalizer["EasyPayProviderPaymentDetails"]</h6>
                            <dl class="row">
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayProviderId"]</dt>
                                <dd class="col-sm-9">
                                    @if (EasyPayBackOfficeLinks.BuildPaymentUrl(providerPayment.Id, WebHostEnvironment) is string providerPaymentUrl)
                                    {
                                        <span>@providerPayment.Id</span>
                                        <a href="@providerPaymentUrl" target="_blank" rel="noopener noreferrer">(@AdminSharedLocalizer["EasyPayViewInBackOffice"])</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayProviderKey"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Key ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayDescription"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Descriptive ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["Value"]</dt>
                                <dd class="col-sm-9">@providerPayment.Value @providerPayment.Currency</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayTransactionCreatedAt"]</dt>
                                <dd class="col-sm-9">@(providerPayment.CreatedAt ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayPaidAt"]</dt>
                                <dd class="col-sm-9">@(providerPayment.PaidAt ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayExpirationTime"]</dt>
                                <dd class="col-sm-9">@(providerPayment.ExpirationTime ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayMethodType"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.Type ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayMethodStatus"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.Status ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCardType"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.CardType?.ToString() ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCardLastFour"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.LastFour ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayEntity"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.Entity ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayReference"]</dt>
                                <dd class="col-sm-9">@(providerPayment.Method?.Reference ?? "—")</dd>
                                <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCustomer"]</dt>
                                <dd class="col-sm-9">
                                    @(providerPayment.Customer?.Name ?? "—")
                                    @if (providerPayment.Customer != null)
                                    {
                                        <span class="text-muted"> — @(providerPayment.Customer.Email ?? "—")</span>
                                    }
                                </dd>
                            </dl>

                            @if (providerPayment.Capture != null)
                            {
                                <h6>@AdminSharedLocalizer["EasyPayCaptureDetails"]</h6>
                                <dl class="row">
                                    <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCaptureId"]</dt>
                                    <dd class="col-sm-9">@(providerPayment.Capture.Id ?? "—")</dd>
                                    <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCaptureStatus"]</dt>
                                    <dd class="col-sm-9">@providerPayment.Capture.Status</dd>
                                    <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCaptureTransactionKey"]</dt>
                                    <dd class="col-sm-9">@(providerPayment.Capture.TransactionKey ?? "—")</dd>
                                    <dt class="col-sm-3">@AdminSharedLocalizer["EasyPayCaptureDate"]</dt>
                                    <dd class="col-sm-9">@providerPayment.Capture.CaptureDate</dd>
                                </dl>
                            }

                            <details>
                                <summary>@AdminSharedLocalizer["EasyPayRawResponse"]</summary>
                                <pre class="small mt-2">@providerPayment.ToJson()</pre>
                            </details>
                        }
                    </div>
                </div>
            }
        }
    </div>
</details>

<h4 class="mt-4">@AdminSharedLocalizer["InvoicesTitle"]</h4>
<hr />
@if (Model.Invoices.Count == 0)
{
    <p class="text-muted">@AdminSharedLocalizer["NoInvoicesFound"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@AdminSharedLocalizer["Number"]</th>
                <th>@AdminSharedLocalizer["Created"]</th>
                <th>@AdminSharedLocalizer["Year"]</th>
                <th>@AdminSharedLocalizer["IsCanceled"]</th>
                <th>@AdminSharedLocalizer["BlobName"]</th>
                <th>@AdminSharedLocalizer["InternalMessage"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var invoice in Model.Invoices)
            {
                <tr>
                    <td>@invoice.Number</td>
                    <td>@invoice.Created.ToString("g")</td>
                    <td>@invoice.Year</td>
                    <td>@invoice.IsCanceled</td>
                    <td>@invoice.BlobName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(invoice.InternalMessage))
                        {
                            <pre class="mb-0 border-0 bg-transparent p-0 small">@invoice.InternalMessage</pre>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/GenerateInvoice"
                           asp-route-publicDonationId="@Model.Donation.PublicId"
                           target="_blank"
                           rel="noopener noreferrer">@AdminSharedLocalizer["ViewInvoice"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-page="./Index">@AdminSharedLocalizer["BackToList"]</a>
</div>
