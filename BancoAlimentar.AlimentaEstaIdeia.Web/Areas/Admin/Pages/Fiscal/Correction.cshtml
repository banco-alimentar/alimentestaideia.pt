@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Fiscal.CorrectionModel
@{
    ViewData["Title"] = "Correct fiscal document";
}

<h1>Correct fiscal document</h1>

<p>A correction creates a new, separately numbered fiscal document linked to the original.</p>

<form method="post" asp-page-handler="Correct">
    <div class="mb-3">
        <label asp-for="Correction.OriginalFiscalDocumentId" class="form-label"></label>
        <input asp-for="Correction.OriginalFiscalDocumentId" class="form-control" />
        <span asp-validation-for="Correction.OriginalFiscalDocumentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Correction.IdempotencyKey" class="form-label"></label>
        <input asp-for="Correction.IdempotencyKey" class="form-control" />
        <span asp-validation-for="Correction.IdempotencyKey" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Correction.Motive" class="form-label"></label>
        <textarea asp-for="Correction.Motive" class="form-control" rows="4" maxlength="1024"></textarea>
        <span asp-validation-for="Correction.Motive" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create fiscal correction</button>
</form>

@if (Model.CorrectionDocument != null)
{
    <section class="mt-4" aria-live="polite">
        <h2>Fiscal correction created</h2>
        <dl>
            <dt>Document</dt>
            <dd>@Model.CorrectionDocument.DocumentNumber</dd>
            <dt>ATCUD</dt>
            <dd>@Model.CorrectionDocument.Atcud</dd>
        </dl>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
