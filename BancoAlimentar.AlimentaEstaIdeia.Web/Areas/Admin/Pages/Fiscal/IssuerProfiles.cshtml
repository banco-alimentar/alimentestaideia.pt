@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Fiscal.IssuerProfilesModel
@{
    ViewData["Title"] = "Fiscal issuer profiles";
}

<h1>Fiscal issuer profiles</h1>

<p>Configure only the issuer information and signing-key reference. The private signing key is never entered, stored, or displayed here.</p>

<form method="post" asp-page-handler="Create">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="IssuerProfile.LegalName" class="form-label"></label>
            <input asp-for="IssuerProfile.LegalName" class="form-control" autocomplete="organization" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IssuerProfile.TaxRegistrationNumber" class="form-label"></label>
            <input asp-for="IssuerProfile.TaxRegistrationNumber" class="form-control" inputmode="numeric" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="IssuerProfile.LegalAddress" class="form-label"></label>
        <textarea asp-for="IssuerProfile.LegalAddress" class="form-control" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.SaftDocumentType" class="form-label"></label>
            <input asp-for="IssuerProfile.SaftDocumentType" class="form-control" maxlength="4" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.TaxRule" class="form-label"></label>
            <input asp-for="IssuerProfile.TaxRule" class="form-control" maxlength="20" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.SoftwareCertificateNumber" class="form-label"></label>
            <input asp-for="IssuerProfile.SoftwareCertificateNumber" class="form-control" inputmode="numeric" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.SigningKeyIdentifier" class="form-label"></label>
            <input asp-for="IssuerProfile.SigningKeyIdentifier" class="form-control" autocomplete="off" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.SigningKeyVersion" class="form-label"></label>
            <input asp-for="IssuerProfile.SigningKeyVersion" class="form-control" autocomplete="off" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="IssuerProfile.ValidFromUtc" class="form-label"></label>
            <input asp-for="IssuerProfile.ValidFromUtc" class="form-control" type="datetime-local" />
        </div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IssuerProfile.IsActive" class="form-check-input" />
        <label asp-for="IssuerProfile.IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Create issuer profile</button>
</form>
