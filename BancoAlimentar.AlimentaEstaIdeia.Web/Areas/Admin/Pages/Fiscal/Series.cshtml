@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Fiscal.SeriesModel
@using BancoAlimentar.AlimentaEstaIdeia.Model
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<header class="fiscal-page-guidance">
    <h1>@Localizer["Title"]</h1>
    <p>@Localizer["Description"]</p>
    <h2 class="h5">@Localizer["GuidanceTitle"]</h2>
    <p>@Localizer["Guidance"]</p>
</header>

<form method="post" asp-page-handler="Configure">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Series.FiscalIssuerProfileId" class="form-label"></label>
            <input asp-for="Series.FiscalIssuerProfileId" class="form-control" min="1" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.SeriesCode" class="form-label"></label>
            <input asp-for="Series.SeriesCode" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.SaftDocumentType" class="form-label"></label>
            <input asp-for="Series.SaftDocumentType" class="form-control" maxlength="4" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Series.ProcessingMethod" class="form-label"></label>
            <select asp-for="Series.ProcessingMethod" asp-items="Html.GetEnumSelectList<FiscalProcessingMethod>()" class="form-select"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.FirstSequence" class="form-label"></label>
            <input asp-for="Series.FirstSequence" class="form-control" min="1" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.NextSequence" class="form-label"></label>
            <input asp-for="Series.NextSequence" class="form-control" min="1" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Series.AtcudValidationCode" class="form-label"></label>
            <input asp-for="Series.AtcudValidationCode" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.AtCommunicationReference" class="form-label"></label>
            <input asp-for="Series.AtCommunicationReference" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Series.StartsAtUtc" class="form-label"></label>
            <input asp-for="Series.StartsAtUtc" class="form-control" type="datetime-local" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Series.Status" class="form-label"></label>
        <select asp-for="Series.Status" asp-items="Html.GetEnumSelectList<FiscalSeriesStatus>()" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["ConfigureFiscalSeries"]</button>
</form>

<hr />

<h2>@Localizer["CloseFiscalSeriesTitle"]</h2>
<form method="post" asp-page-handler="Close" onsubmit="return confirm('@Localizer["CloseFiscalSeriesConfirmation"]');">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FiscalDocumentSeriesId" class="form-label"></label>
        <input asp-for="FiscalDocumentSeriesId" class="form-control" min="1" />
    </div>
    <button type="submit" class="btn btn-warning">@Localizer["CloseFiscalSeries"]</button>
</form>
