@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Fiscal.SimulationsModel
@{
    ViewData["Title"] = "Consulta de simulações fiscais";
}

<header class="fiscal-page-guidance" role="banner">
    <h1>Consulta de simulações fiscais</h1>
    <p class="alert alert-warning mb-3" role="alert"><strong>SIMULAÇÃO — SEM VALIDADE FISCAL</strong></p>
    <p>Esta página permite confirmar os recibos de teste emitidos neste ambiente de desenvolvimento. Os identificadores, códigos QR, verificações locais e ficheiros apresentados são sintéticos e não podem ser comunicados à Autoridade Tributária, usados em SAF-T, nem substituem documentos fiscais.</p>
    <p>Os registos são apenas de consulta. Não existem nesta página ações de emissão, descarregamento, exportação, anulação, retificação ou promoção.</p>
</header>

@if (Model.Records.Count == 0)
{
    <p class="mt-4">Ainda não foram emitidos recibos em modo de simulação nesta base de dados do tenant.</p>
}
else
{
    <div class="table-responsive mt-4">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Identificador sintético</th>
                    <th scope="col">Donativo</th>
                    <th scope="col">Âmbito</th>
                    <th scope="col">Estratégia</th>
                    <th scope="col">Banco alimentar</th>
                    <th scope="col">Sequência</th>
                    <th scope="col">Verificação local</th>
                    <th scope="col">Referência do artefacto</th>
                    <th scope="col">Origem</th>
                    <th scope="col">Emitido em</th>
                    <th scope="col">Auditoria da simulação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td>@record.Id</td>
                        <td>@record.SyntheticIdentifier</td>
                        <td>@record.DonationId</td>
                        <td>@record.ScopeKey</td>
                        <td>@record.InvoicingStrategy</td>
                        <td>@(record.FoodBankId?.ToString() ?? "—")</td>
                        <td>@record.Sequence</td>
                        <td><code>@record.LocalChecksum</code></td>
                        <td><code>@record.ArtifactReference</code></td>
                        <td>@record.OriginEnvironment</td>
                        <td>@record.IssuedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</td>
                        <td>
                            @if (record.AuditEvents.Count == 0)
                            {
                                <span>Sem eventos de auditoria.</span>
                            }
                            else
                            {
                                <ul class="mb-0 ps-3">
                                    @foreach (var auditEvent in record.AuditEvents)
                                    {
                                        <li>@auditEvent</li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
