@page
@model BancoAlimentar.AlimentaEstaIdeia.Web.Areas.Admin.Pages.Fiscal.SaftExportModel
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<header class="fiscal-page-guidance">
    <h1>@Localizer["Title"]</h1>
    <p>@Localizer["Description"]</p>
    <h2 class="h5">@Localizer["GuidanceTitle"]</h2>
    <p>@Localizer["Guidance"]</p>
</header>

<form method="post" asp-page-handler="Export">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="FiscalIssuerProfileId" class="form-label"></label>
            <input asp-for="FiscalIssuerProfileId" class="form-control" min="1" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["ExportSaft"]</button>
</form>
